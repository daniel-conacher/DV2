{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "More gardens are drawing big crowds",
    "subtitle": "Share of responding gardens in each band. CGA surveys: 240 responses in 2023, 249 in 2024"
  },
  "width": "container",
  "height": 300,
  "data": {
    "url": "data/cga_distributions_2023_2024.csv"
  },
  "params": [
    {
      "name": "Measure_selection",
      "value": "Weekly visits per garden",
      "bind": {
        "input": "select",
        "options": [
          "Weekly visits per garden",
          "Volunteer hours per week",
          "Total members"
        ],
        "labels": [
          "Visitors per week",
          "Volunteer hours per week",
          "Members per garden"
        ],
        "name": "Measure: "
      }
    }
  ],
  "transform": [
    {"filter": "datum.question == Measure_selection"},
    {"calculate": "toString(datum.year)", "as": "Survey"},
    {"calculate": "datum.gardens / datum.base", "as": "Share of gardens"}
  ],
  "encoding": {
    "x": {
      "field": "band",
      "type": "ordinal",
      "sort": {"field": "band_order", "op": "min"},
      "title": null,
      "axis": {"labelAngle": 0}
    },
    "y": {
      "field": "Share of gardens",
      "type": "quantitative",
      "axis": {"format": "%", "tickCount": 5}
    },
    "color": {
      "field": "Survey",
      "type": "nominal",
      "title": "Survey",
      "scale": {
        "domain": ["2023", "2024"],
        "range": ["#5e9a55", "#2e6b34"]
      },
      "legend": {"orient": "top", "direction": "horizontal"}
    }
  },
  "layer": [
    {
      "mark": {"type": "line", "strokeWidth": 2}
    },
    {
      "mark": {"type": "circle", "size": 80, "opacity": 1},
      "encoding": {
        "tooltip": [
          {"field": "band", "type": "nominal", "title": "Band"},
          {"field": "Survey", "type": "nominal"},
          {"field": "gardens", "type": "quantitative", "title": "Gardens"},
          {"field": "Share of gardens", "type": "quantitative", "format": ".1%"},
          {"field": "base", "type": "quantitative", "title": "Responses that year"}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "clip": true,
        "align": "right",
        "baseline": "bottom",
        "dx": 10,
        "dy": -90,
        "fontSize": 11.5,
        "fontStyle": "italic"
      },
      "encoding": {
        "text": {"value": ["17 gardens had 100+", "visitors a week in 2024,", "up from 2 in 2023"]},
        "color": {"value": "#4f554c"},
        "opacity": {
          "condition": {
            "test": "datum['question'] == 'Weekly visits per garden' && datum['band'] == '200+' && datum['Survey'] == '2024'",
            "value": 1
          },
          "value": 0
        }
      }
    }
  ],
  "config": {
    "font": "Open Sans",
    "view": {"stroke": null},
    "axisX": {"grid": false},
    "axisY": {"domain": false, "ticks": false}
  }
}