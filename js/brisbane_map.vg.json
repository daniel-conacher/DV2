{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Only 7 of Brisbane's 49 council-listed gardens are in the national directory",
    "subtitle": "Brisbane City Council community gardens and city farms. Click the legend to highlight a group"
  },
  "width": "container",
  "height": 480,
  "projection": {"type": "equalEarth", "rotate": [-153, 0, 0]},
  "layer": [
    {
      "data": {
        "url": "js/lga_2021.topojson",
        "format": {"type": "topojson", "feature": "lga_2021"}
      },
      "transform": [
        {"filter": "datum.properties.LGA_NAME21 == 'Brisbane'"}
      ],
      "mark": {"type": "geoshape", "fill": "lightgray", "stroke": "white"}
    },
    {
      "data": {
        "url": "data/brisbane_gardens_matched.csv"
      },
      "params": [
        {
          "name": "status_highlight",
          "select": {"type": "point", "fields": ["directory_status"]},
          "bind": "legend"
        }
      ],
      "mark": {"type": "circle", "size": 90, "stroke": "white", "strokeWidth": 1},
      "encoding": {
        "longitude": {"field": "long", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "color": {
          "field": "directory_status",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": ["Listed in national directory", "Not listed"],
            "range": ["#2e6b34", "#eb6834"]
          },
          "legend": {"orient": "top-left"}
        },
        "opacity": {
          "condition": {"param": "status_highlight", "value": 0.9},
          "value": 0.15
        },
        "tooltip": [
          {"field": "name", "type": "nominal", "title": "Garden"},
          {"field": "suburb", "type": "nominal", "title": "Suburb"},
          {"field": "directory_status", "type": "nominal", "title": "Directory"},
          {"field": "directory_name", "type": "nominal", "title": "Listed as"},
          {"field": "kind", "type": "nominal", "title": "Type"}
        ]
      }
    }
  ],
  "config": {
    "font": "Open Sans",
    "view": {"stroke": null}
  }
}