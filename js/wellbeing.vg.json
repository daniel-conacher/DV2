{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Most gardeners say they are better off for joining",
    "subtitle": "Share of survey respondents agreeing with each statement. CGA surveys, 2022–2024"
  },
  "width": "container",
  "height": 300,
  "data": {
    "url": "data/cga_survey_change_2021_2024.csv"
  },
  "transform": [
    {"filter": "datum.theme == 'Wellbeing'"},
    {"calculate": "toString(datum.year)", "as": "Survey"},
    {"calculate": "datum.value / 100", "as": "Respondents agreeing"},
    {
      "calculate": "datum.metric == 'Health and wellbeing improved' ? 'Health and wellbeing' : datum.metric == 'Skills to grow food at home improved' ? 'Food-growing skills' : 'Lower food costs'",
      "as": "Benefit"
    }
  ],
  "encoding": {
    "x": {
      "field": "Survey",
      "type": "ordinal",
      "sort": ["2022", "2023", "2024"],
      "axis": {"labelAngle": 0},
      "scale": {"padding": 0.3}
    },
    "y": {
      "field": "Respondents agreeing",
      "type": "quantitative",
      "title": null,
      "axis": {"format": "%", "tickCount": 4},
      "scale": {"domain": [0.6, 1]}
    },
    "color": {
      "field": "Benefit",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": ["Health and wellbeing", "Food-growing skills", "Lower food costs"],
        "range": ["#2a78d6", "#eb6834", "#1baf7a"]
      },
      "legend": {"orient": "top", "direction": "horizontal"}
    }
  },
  "layer": [
    {
      "mark": {"type": "line", "strokeWidth": 2}
    },
    {
      "mark": {"type": "circle", "size": 80, "opacity": 1},
      "encoding": {
        "tooltip": [
          {"field": "Benefit", "type": "nominal"},
          {"field": "Survey", "type": "ordinal"},
          {"field": "Respondents agreeing", "type": "quantitative", "format": ".1%"},
          {"field": "source", "type": "nominal", "title": "Source"},
          {"field": "note", "type": "nominal", "title": "Note"}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 10,
        "fontSize": 12,
        "fontWeight": "bold"
      },
      "encoding": {
        "text": {"field": "Respondents agreeing", "type": "quantitative", "format": ".3~p"},
        "color": {"value": "black"},
        "opacity": {
          "condition": {"test": "datum['Survey'] == '2024'", "value": 1},
          "value": 0
        }
      }
    }
  ],
  "config": {
    "font": "Open Sans",
    "view": {"stroke": null},
    "axisX": {"grid": false, "title": null},
    "axisY": {"domain": false, "ticks": false}
  }
}