{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "More gardens are drawing big crowds",
   "subtitle": [
  "Share of responding gardens in each band: 2023 to the left, 2024 to the right.",
  "CGA surveys, 240 and 249 responses"
]
  },
  "width": "container",
  "height": 280,
  "data": {
    "url": "data/cga_distributions_2023_2024.csv"
  },
  "params": [
    {
      "name": "Measure_selection",
      "value": "Weekly visits per garden",
      "bind": {
        "input": "select",
        "options": [
          "Weekly visits per garden",
          "Volunteer hours per week",
          "Total members"
        ],
        "labels": [
          "Visitors per week",
          "Volunteer hours per week",
          "Members per garden"
        ],
        "name": "Measure: "
      }
    }
  ],
  "transform": [
    {
      "filter": "datum.question == Measure_selection"
    },
    {
      "calculate": "toString(datum.year)",
      "as": "Survey"
    },
    {
      "calculate": "datum.gardens / datum.base",
      "as": "Share of gardens"
    },
    {
      "calculate": "datum.year == 2023 ? -datum['Share of gardens'] : datum['Share of gardens']",
      "as": "Signed share"
    }
  ],
  "encoding": {
    "y": {
      "field": "band",
      "type": "ordinal",
      "sort": {
        "field": "band_order",
        "op": "min",
        "order": "descending"
      },
      "title": null,
      "axis": {
        "labelFontSize": 12,
        "domain": false,
        "ticks": false,
        "labelPadding": 8
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 3,
        "height": {
          "band": 0.75
        }
      },
      "encoding": {
        "x": {
          "field": "Signed share",
          "type": "quantitative",
          "title": "Share of responding gardens",
          "scale": {
            "domain": [
              -0.45,
              0.45
            ]
          },
          "axis": {
            "labelExpr": "format(abs(datum.value), '.0%')",
            "tickCount": 7
          }
        },
        "color": {
          "field": "Survey",
          "type": "nominal",
          "title": "Survey",
          "scale": {
            "domain": [
              "2023",
              "2024"
            ],
            "range": [
              "#5e9a55",
              "#2e6b34"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal"
          }
        },
        "tooltip": [
          {
            "field": "band",
            "type": "nominal",
            "title": "Band"
          },
          {
            "field": "Survey",
            "type": "nominal"
          },
          {
            "field": "gardens",
            "type": "quantitative",
            "title": "Gardens"
          },
          {
            "field": "Share of gardens",
            "type": "quantitative",
            "format": ".1%"
          },
          {
            "field": "base",
            "type": "quantitative",
            "title": "Responses that year"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2023"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 11,
        "align": "right",
        "dx": -4
      },
      "encoding": {
        "x": {
          "field": "Signed share",
          "type": "quantitative"
        },
        "text": {
          "field": "Share of gardens",
          "type": "quantitative",
          "format": ".0%"
        },
        "color": {
          "value": "#4f554c"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2024"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 11,
        "align": "left",
        "dx": 4
      },
      "encoding": {
        "x": {
          "field": "Signed share",
          "type": "quantitative"
        },
        "text": {
          "field": "Share of gardens",
          "type": "quantitative",
          "format": ".0%"
        },
        "color": {
          "value": "#4f554c"
        }
      }
    },
    {
      "mark": {
        "type": "rule",
        "color": "#1d211c",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "datum": 0
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 40,
        "fontSize": 11.5,
        "fontStyle": "italic"
      },
      "encoding": {
        "x": {
          "field": "Signed share",
          "type": "quantitative"
        },
        "text": 
        {"value": ["17 gardens had 100+ visitors", "a week in 2024, up from 2"]},
        "color": {
          "value": "#4f554c"
        },
        "opacity": {
          "condition": {
            "test": "datum['question'] == 'Weekly visits per garden' && datum['band'] == '101-200' && datum['Survey'] == '2024'",
            "value": 1
          },
          "value": 0
        }
      }
    }
  ],
  "config": {
    "font": "Open Sans",
    "view": {
      "stroke": null
    },
    "axisX": {
      "grid": true,
      "gridColor": "#eceae4"
    }
  }
}