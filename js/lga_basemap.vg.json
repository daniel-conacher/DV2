{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Local Government Areas (ABS 2021)",
  "width": 700,
  "height": 600,
  "projection": {"type": "conicEqualArea", "parallels": [-18, -36], "rotate": [-132, 0]},
  "data": {
    "url": "js/lga_2021.topojson",
    "format": {"type": "topojson", "feature": "lga_2021"}
  },
  "mark": {"type": "geoshape", "fill": "#e6e6e6", "stroke": "white", "strokeWidth": 0.5},
  "encoding": {
    "tooltip": [
      {"field": "properties.LGA_NAME21", "type": "nominal", "title": "LGA"},
      {"field": "properties.STE_NAME21", "type": "nominal", "title": "State"},
      {"field": "properties.LGA_CODE21", "type": "nominal", "title": "LGA code"}
    ]
  }
}
